{
  "name": "wp-auto-translator",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:start:tests": "wp-env start --config=.wp-env.tests.json",
    "env:stop:tests": "wp-env stop --config=.wp-env.tests.json",
    "env:destroy:tests": "wp-env destroy --config=.wp-env.tests.json",
    "test:php": "wp-env run --config=.wp-env.tests.json cli --env-cwd=wp-content/plugins/wp-auto-translator ./vendor/bin/phpunit -c phpunit.wp.xml.dist",
    "wp": "wp-env run cli wp",
    "plugin:zip": "node scripts/package-plugin.mjs"
  },
  "devDependencies": {
    "@wordpress/env": "^12.0.0"
  }
}
